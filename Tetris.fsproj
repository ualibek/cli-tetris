<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Tetris</RootNamespace>
    <AssemblyName>Tetris</AssemblyName>
    <Nullable>enable</Nullable>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <!-- Files MUST be listed in dependency order for F# -->
  <ItemGroup>
    <Compile Include="src\Types.fs" />
    <Compile Include="src\Pieces.fs" />
    <Compile Include="src\Board.fs" />
    <Compile Include="src\Scoring.fs" />
    <Compile Include="src\Input.fs" />
    <Compile Include="src\Render.fs" />
    <Compile Include="src\Game.fs" />
    <Compile Include="src\Program.fs" />
  </ItemGroup>

</Project>